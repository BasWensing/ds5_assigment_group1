    "# Exercise 3.1: Barbasi-Albert netwerk aanmaken\n",
    "import random\n",
    "import matplotlib.pyplot as plt\n",
    "import networkx as nx\n",
    "\n",
    "''' Parameters definiëren. Dennis '''\n",
    "\n",
    "\n",
    "''' Functie 'Barbasi_albert' aanmaken. Dennis '''\n",
    "def barbasi_albert(N, k, M): \n",
    "\n",
    "    ''' Functie 'klein netwerk' uitvoeren voor k punten, grafiek van netwerk opslaan. Dennis '''\n",
    "    G = klein_netwerk(k)\n",
    "\n",
    "    ''' Links toevoegen. Bas '''\n",
    "    for i in range(k + 1, N):\n",
    "\n",
    "        ''' Bestaande knopen opslaan in lijst, knopen ophalen uit grafiek van netwerk. Dennis '''\n",
    "        bestaande_knopen = list(G.nodes())\n",
    "\n",
    "        ''' Di vinden voor de gewichten (Pi). Bas / Dennis '''\n",
    "        ''' Di = aantal pagina-links dat nummer i bezit. Dennis '''\n",
    "        ''' Pi = waarschijnlijkheid dat pagina k+i linkt met punt i. Dennis '''\n",
    "\n",
    "        ''' Graad voor ieder punt i bepaald. Dennis '''\n",
    "        graden = [G.degree(n) for n in bestaande_knopen]\n",
    "\n",
    "        ''' Set-functie 'doelen' aanmaken. Dennis '''\n",
    "        doelen = set()\n",
    "        \n",
    "        ''' Juist aantal knopen en links instellen. Bas '''\n",
    "        while len(doelen) < M: # Als de lengte van 'doelen' kleiner is dan het aantal verschillende pagina's, kunnen er knopen worden toegevoegd. Dennis\n",
    "            # Knoop kiezen op basis van zijn graad. Bas\n",
    "            doel = random.choices(bestaande_knopen, weights=graden)[0] # Knoop random kiezen met kans = graden. Dennis\n",
    "            doelen.add(doel) # Knoop toevoegen aan 'doelen'. Dennis\n",
    "\n",
    "        ''' Nieuwe verbindingen toevoegen aan knopen in netwerk. Bas / Dennis '''\n",
    "        for doel in doelen: # Over iedere knoop itereren. Dennis\n",
    "            G.add_edge(i, doel) # Verbinding (link) toevoegen aan knoop. Dennis\n",
    "\n",
    "    ''' Netwerktekening opslaan in Python. Dennis '''\n",
    "    nx.draw(G, with_labels=False)\n",
    "\n",
    "    ''' Titel en netwerk plotten. Dennis '''\n",
    "    plt.title(f'Plot van Barabasi-Albert netwerk met N = {N}, k = {k} en M = {M}')\n",
    "    plt.show()\n",
    "\n",
    "''' Netwerk aanmaken en opslaan in de variabele G. Bas '''\n",
    "G = barbasi_albert(10,9,7)\n",
    "\n",
    "# N = aantal webpagina's. Dennis\n",
    "# k = aantal knopen rond 1 middelpunt. Dennis\n",
    "# M = aantal bestaande, verschillende pagina's van het sternetwerk. Dennis\n",
    "\n",
    "# Netwerk visualiseren\n"
